{
  "expo": {
    "name": "Quiz Arena",
    "slug": "quiz-arena-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/quiz-arena-icon.png",
    "scheme": "quizarena",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/quiz-arena-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/quiz-arena-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/quiz-arena-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F7",
          "dark": {
            "backgroundColor": "#F3F5F7"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}